#!/usr/bin/env bash
# Bring up the local kind cluster and deploy the dev overlay (DESIGN.md §14.2).
#
# Idempotent: safe to re-run to redeploy after a code change. Tear down with
# `kind delete cluster --name boba-gals`.
set -euo pipefail

CLUSTER=boba-gals
NAMESPACE=boba-gals
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TAG=dev
HOST=boba.localtest.me
PORT=8443
CERT_MANAGER_VERSION=v1.16.2
KUBE_PROMETHEUS_STACK_VERSION=88.3.0

cd "$ROOT"

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

if ! kind get clusters 2>/dev/null | grep -qx "$CLUSTER"; then
  step "Creating kind cluster"
  kind create cluster --name "$CLUSTER" --config k8s/kind/cluster.yaml
else
  step "Cluster $CLUSTER already exists"
fi

kubectl config use-context "kind-$CLUSTER" >/dev/null

# Helm is for third-party charts only (§14.2) — this app is always plain
# manifests. ingress-nginx is exactly the case Helm is allowed for, but its
# kind-specific manifest is simpler still and pinned to a known-good version.
if ! kubectl get namespace ingress-nginx >/dev/null 2>&1; then
  step "Installing ingress-nginx"
  kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.11.3/deploy/static/provider/kind/deploy.yaml
fi

# cert-manager, on the same terms as ingress-nginx: third-party, pinned, applied
# from its released manifest. It owns the Certificate in
# k8s/overlays/dev/tls.yaml and writes the `boba-tls` Secret the Ingress reads.
if ! kubectl get namespace cert-manager >/dev/null 2>&1; then
  step "Installing cert-manager"
  kubectl apply -f "https://github.com/cert-manager/cert-manager/releases/download/${CERT_MANAGER_VERSION}/cert-manager.yaml"
fi

# `rollout status`, not `wait --for=condition=Ready pod`: the pod does not exist
# for a moment after apply, and `wait` fails outright on an empty selector
# rather than waiting for something to match it.
step "Waiting for ingress-nginx"
kubectl -n ingress-nginx rollout status deployment/ingress-nginx-controller --timeout=300s

# All three, not just the controller. The webhook is the one that matters here:
# it validates every Certificate and Issuer, and applying the manifests while it
# is still coming up fails with "connection refused" on the admission call
# rather than anything mentioning certificates.
step "Waiting for cert-manager"
for d in cert-manager cert-manager-webhook cert-manager-cainjector; do
  kubectl -n cert-manager rollout status "deployment/$d" --timeout=300s
done

step "Building images"
docker build -t "boba-api:$TAG" --target production .
docker build -t "boba-frontend:$TAG" frontend

# There is no registry: kind nodes are containers with their own image store,
# so images have to be side-loaded. This is why the dev overlay sets
# imagePullPolicy to IfNotPresent.
step "Loading images into the cluster"
kind load docker-image "boba-api:$TAG" "boba-frontend:$TAG" --name "$CLUSTER"

step "Applying manifests"
kubectl apply -k k8s/overlays/dev

# The Ingress mounts the `boba-tls` Secret, and nginx serves its built-in
# "Kubernetes Ingress Controller Fake Certificate" until that Secret exists.
# Waiting on Ready means a failure here reads as "the certificate did not
# issue", not as an unexplained TLS warning ten minutes later.
step "Waiting for the certificate to issue"
kubectl -n "$NAMESPACE" wait --for=condition=Ready certificate/boba-tls --timeout=180s

# Migrations belong to the Job, never to container boot (§14.2). Waiting here
# means `web` is not serving traffic against a schema that has not been applied.
step "Waiting for migrations"
kubectl -n "$NAMESPACE" wait --for=condition=complete job/migrate --timeout=300s

# Pods that started before the Job finished may have crash-looped against a
# missing schema; a restart clears that rather than waiting out the backoff.
step "Restarting application pods"
kubectl -n "$NAMESPACE" rollout restart deployment/web deployment/worker deployment/frontend
kubectl -n "$NAMESPACE" rollout status deployment/web --timeout=300s
kubectl -n "$NAMESPACE" rollout status deployment/frontend --timeout=300s

# §15. Skipped in CI: the full chart (Prometheus, Grafana, kube-state-metrics,
# node-exporter) is real memory weight on top of everything else the cluster
# job already runs, and CI's smoke test only needs to prove the app side works
# — that /metrics serves real data — not that Prometheus is scraping it.
# Verified locally instead; not part of the automated suite.
if [ -z "${CI:-}" ]; then
  step "Installing kube-prometheus-stack"
  helm repo add prometheus-community https://prometheus-community.github.io/helm-charts >/dev/null
  helm repo update prometheus-community >/dev/null
  helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
    --namespace monitoring --create-namespace \
    --version "$KUBE_PROMETHEUS_STACK_VERSION" \
    -f k8s/kube-prometheus-stack-values.yaml \
    --wait --timeout 5m

  # A CRD from that chart, so this can only apply now that it exists — never
  # part of k8s/base or k8s/overlays/* (see the comment in each file).
  step "Applying monitoring manifests"
  kubectl apply -f k8s/monitoring/
fi

step "Ready"
kubectl -n "$NAMESPACE" get pods

# The CA is self-signed, so a browser warns until it is trusted. Write it out
# rather than describing it: trusting is optional — clicking through the warning
# leaves you on an https origin and everything works — but it is one command,
# and a warning dismissed daily is a warning nobody reads.
kubectl -n "$NAMESPACE" get secret boba-ca -o jsonpath='{.data.tls\.crt}' | base64 -d > "$ROOT/tmp/boba-ca.crt"

printf '\nThe shop is at \033[1mhttps://%s:%s\033[0m — board at /board\n' "$HOST" "$PORT"
printf '\nThe certificate is signed by a CA this cluster minted, so the browser will\n'
printf 'warn. Clicking through works — the origin is still https. To stop the warning:\n\n'
case "$(uname -s)" in
  Darwin)
    printf '  \033[2msudo security add-trusted-cert -d -r trustRoot \\\n'
    printf '    -k /Library/Keychains/System.keychain tmp/boba-ca.crt\033[0m\n' ;;
  Linux)
    printf '  \033[2msudo cp tmp/boba-ca.crt /usr/local/share/ca-certificates/boba-gals.crt \\\n'
    printf '    && sudo update-ca-certificates\033[0m\n' ;;
  *)
    printf '  \033[2mtrust tmp/boba-ca.crt in your system certificate store\033[0m\n' ;;
esac
printf '\nNo sudo needed for scripts — point curl at the CA directly:\n\n'
printf '  \033[2mcurl --cacert tmp/boba-ca.crt https://%s:%s/api/v1/health\033[0m\n' "$HOST" "$PORT"

if [ -z "${CI:-}" ]; then
  printf '\nGrafana (§15) has no Ingress rule — port-forward to reach it:\n\n'
  printf '  \033[2mkubectl -n monitoring port-forward svc/kube-prometheus-stack-grafana 3001:80\033[0m\n'
  printf '  then http://localhost:3001 — admin / dev-only-not-a-real-password\n'
fi
