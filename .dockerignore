# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# The React app is a separate image (boba-frontend, §14.1) — keep it out of the
# API build context so a frontend-only change doesn't bust the Ruby gem layer.
/frontend/

# Test and docs artifacts have no place in a runtime image.
/spec/
/coverage/
/docs/
/DESIGN.md
/CLAUDE.md
/CHANGELOG.md
/lefthook.yml
/.claude/
/.github/

# Deployment config describes the container; it does not belong inside it.
#
# Beyond tidiness, this is about the build cache: k8s/ sat in the same COPY
# layer as the application, so editing a manifest invalidated it and produced a
# fresh ~42MB image version (the bootsnap cache dominates that layer) for a
# change that touched no Ruby at all. With it excluded, a manifest-only commit
# rebuilds to a byte-identical layer that the registry deduplicates to nothing.
/k8s/
