{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bundle exec rspec*)",
      "Bash(bundle exec rubocop*)",
      "Bash(bundle exec rails runner*)",
      "Bash(bundle exec rails db:migrate:status*)",
      "Bash(bundle exec rails routes*)",
      "Bash(bundle exec rails notes*)",
      "Bash(bundle install*)",
      "Bash(bundle info*)",
      "Bash(bin/rspec*)",
      "Bash(bin/rails routes*)",
      "Bash(bin/rails db:migrate:status*)",
      "Bash(bin/rubocop*)",
      "Bash(npm --prefix frontend test*)",
      "Bash(npm --prefix frontend run lint*)",
      "Bash(npm --prefix frontend run build*)",
      "Bash(npm --prefix frontend ci*)",
      "Bash(npm --prefix frontend install*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Bash(docker compose build*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl diff*)",
      "Bash(kubectl kustomize*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)"
    ],
    "deny": [
      "Read(./config/master.key)",
      "Read(./config/credentials/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
