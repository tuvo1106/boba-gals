# Rails
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/config/master.key
/config/credentials/*.key

# Test artifacts
/coverage

# The scheduler gem runs its own suite, so it produces its own coverage report
# (ADR-0033).
/gems/*/coverage
/spec/examples.txt
/tmp/screenshots

# Frontend
node_modules/
/frontend/dist
/frontend/node_modules
*.tsbuildinfo
.vite/

# Environment — secrets come from the environment only (DESIGN.md §14.6)
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
*.swp

# Claude Code — local overrides stay local, shared settings are committed
.claude/settings.local.json

# Ignore key files for decrypting credentials and more.
/config/*.key


# Mutant's session cache — one ~33MB JSON per run. Swept in by `git add -A`
# before this rule existed; they compress to almost nothing in git but
# materialise as hundreds of megabytes in every working tree.
/.mutant/
